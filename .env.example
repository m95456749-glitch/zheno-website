# Base URL of the backend API. Leave empty for frontend-only (demo) mode.
VITE_API_BASE_URL=

# Feature flags
VITE_ENABLE_CHECKOUT=true
VITE_ENABLE_ACCOUNT=false

# Admin panel authentication:
#   demo (default) — no real authentication; the panel is preview-only
#                    and the UI says so (no credentials are stored).
#   api — requires VITE_API_BASE_URL; login goes to the backend's
#         /admin/auth endpoints (see src/admin/auth/authService.ts).
VITE_ADMIN_AUTH_MODE=demo
