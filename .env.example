# ============================================================
# ZHINO — frontend build-time environment (COPY TO .env.local)
# Vite inlines every VITE_* value into the PUBLIC bundle, so a
# value placed here is readable by any visitor. Never put a
# Supabase service-role / secret key, a database password, or
# any payment credential in a VITE_* variable. `npm run
# check:env` (runs before `npm run build`) fails the build if
# one appears here, in src/, or in dist/.
# ============================================================

# Supabase project URL, e.g. https://XXXXXXXX.supabase.co
# Empty = frontend-only mode (no network calls at all).
VITE_SUPABASE_URL=

# Supabase browser key: the "anon" / "publishable" (sb_publishable_...) key
# ONLY. Data access is limited by the project's RLS policies.
# NEVER the "service_role" / secret_role key.
VITE_SUPABASE_ANON_KEY=

# Base URL of an optional external backend API. Leave empty for
# frontend-only (demo) mode.
VITE_API_BASE_URL=

# Feature flags
VITE_ENABLE_CHECKOUT=true
VITE_ENABLE_ACCOUNT=false

# Admin panel authentication:
#   demo (default) — no real authentication; the panel is preview-only
#                    and the UI says so (no credentials are stored).
#   api — requires VITE_API_BASE_URL; login goes to the backend's
#         /admin/auth endpoints (see src/admin/auth/authService.ts).
VITE_ADMIN_AUTH_MODE=demo
