# Base URL of the backend API. Leave empty for frontend-only (demo) mode.
VITE_API_BASE_URL=

# Feature flags
VITE_ENABLE_CHECKOUT=true
VITE_ENABLE_ACCOUNT=false

# ── Supabase (admin panel ↔ real database) ──────────────────
# Copy these two from Supabase Dashboard → Project Settings → API.
# ONLY public values belong here: the project URL and the PUBLISHABLE
# (anon) key. Both are safe to ship — data access is decided by the
# database's Row Level Security policies, never by the key.
#
# NEVER put the service_role / secret key (sb_secret_… ) here: it
# bypasses RLS. The app refuses to start against the database if it
# detects one, and scripts/verify-supabase.mjs fails the build if such
# a key is ever committed.
#
# Leave both empty to run the site in its original offline mode
# (static catalog + localStorage overlay).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy variable name, still accepted if your dashboard shows the
# "anon public" key instead of a publishable key.
# VITE_SUPABASE_ANON_KEY=

# ── دستیار ژینو (فاز ۵) ─────────────────────────────────────
# آدرس Endpoint دستیار هوشمند روی Backend خودمان (اختیاری).
# خالی بماند:
#   • اگر Supabase پیکربندی شده باشد → از Edge Function پروژه
#     استفاده می‌شود: <VITE_SUPABASE_URL>/functions/v1/zhino-assistant
#   • در غیر این صورت → دستیار با «موتور محلی» فروشگاه پاسخ می‌دهد
#     (همهٔ پاسخ‌ها از کاتالوگ واقعی؛ بدون هیچ درخواست شبکه‌ای).
#
# ⚠️ کلید مدل هوش مصنوعی هرگز اینجا نمی‌آید. کلید فقط در Secrets
# سرور (Supabase Edge Function → AI_API_KEY / AI_MODEL، یا Backend
# خودتان) نگه داشته می‌شود. هر متغیری که با VITE_ شروع شود در بستهٔ
# نهایی مرورگر قرار می‌گیرد و برای همه قابل خواندن است.
#
# اگر فقط Supabase را تنظیم کرده باشید (دو متغیر بالاتر)، دستیار
# خودش Edge Function را صدا می‌زند و تابع، محصولات/قیمت/موجودی/
# دستورها/تنظیمات ارسال را با کلید anon از همان دیتابیس می‌خواند
# (تحت RLS). چیز دیگری برای «دادهٔ واقعی» لازم نیست.
VITE_ASSISTANT_API_URL=

# ── صدای ابری فارسی دستیار (فاز ۹) ────────────────────────────
# اینجا هیچ متغیری لازم نیست: خواندن پاسخ با صدای ابری
# (Azure → fa-IR-DilaraNeural) خودش از همان دو متغیر Supabase بالا
# استفاده می‌کند و Edge Function «zhino-voice» را صدا می‌زند.
# کلید Azure فقط در Supabase Secrets می‌ماند (AZURE_SPEECH_KEY /
# AZURE_SPEECH_REGION) و هرگز وارد فرانت‌اند یا این فایل نمی‌شود.
# اگر Supabase تنظیم نشده باشد، صدا مثل قبل با موتور خود مرورگر
# خوانده می‌شود و هیچ درخواستی رد و بدل نمی‌شود.

# Admin panel authentication:
#   (unset) — Supabase Auth when the two variables above are set,
#             otherwise the demo preview below.
#   supabase — force Supabase Auth + the database's is_admin() role check.
#   demo — no real authentication; the panel is preview-only and the UI
#          says so (no credentials are stored).
#   api — requires VITE_API_BASE_URL; login goes to the backend's
#         /admin/auth endpoints (see src/admin/auth/authService.ts).
VITE_ADMIN_AUTH_MODE=
