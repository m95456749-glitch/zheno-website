# Optional Supabase browser connection. The anon/publishable key is protected by
# the SQL migration's RLS policies. Never put a service-role key in VITE_* vars.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional external API/payment gateway. Leave empty for Supabase-only checkout.
VITE_API_BASE_URL=

# Feature flags
VITE_ENABLE_CHECKOUT=true
VITE_ENABLE_ACCOUNT=false

# Admin authentication:
#   supabase — production mode; uses Supabase Auth and PostgreSQL RLS.
#   demo     — credential-free preview only; never use for production.
#   api      — legacy external backend auth provider.
VITE_ADMIN_AUTH_MODE=supabase
