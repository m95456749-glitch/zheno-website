# dependencies
node_modules/

# build output
dist/
dist-ssr/
*.local

# logs
logs/
*.log
npm-debug.log*

# environment files (never commit real secrets)
.env
.env.*
!.env.example

# Supabase CLI local artifacts (never commit local state or credentials)
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/**/*.local

# editor / os
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
.qa/

# Python automation test/import caches
__pycache__/
*.py[cod]
