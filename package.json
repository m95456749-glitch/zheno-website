{
  "name": "zheno-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ZHINO — فروشگاه پودر ژله و کاستر",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:data": "node scripts/verify-data.mjs",
    "verify:supabase": "node scripts/verify-supabase.mjs",
    "verify:admin": "node scripts/verify-admin.mjs",
    "test:catalog-validation": "node scripts/test-catalog-validation.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:voice-android": "node scripts/tts-android-sim.mjs",
    "test:voice-cloud": "node scripts/tts-cloud-sim.mjs",
    "verify:voice": "node scripts/verify-voice.mjs",
    "verify:voice-settings": "node scripts/verify-voice-settings-ui.mjs",
    "test:images:db": "node scripts/test-product-images-db.mjs",
    "test:images:browser": "node scripts/test-product-images-browser.mjs",
    "test:images": "node scripts/test-product-images.mjs && npm run test:images:db",
    "verify:images:bundle": "node scripts/verify-image-bundle.mjs",
    "test:images:migration": "node scripts/test-product-image-migration-safety.mjs",
    "test:images:automation": "python3 scripts/test-product-image-automation.py",
    "test:images:cli": "node scripts/test-product-image-cli.mjs",
    "verify:assistant-scene": "node scripts/verify-assistant-scene.mjs",
    "deploy": "wrangler deploy",
    "dev:worker": "wrangler dev --ip 0.0.0.0",
    "deploy:check": "wrangler deploy --dry-run",
    "test:worker": "node scripts/test-worker-assets.mjs",
    "test:preview:isolation": "node scripts/test-preview-isolation.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tailwind-merge": "^2.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "pg": "8.23.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "undici@7.29.1": "7.30.1"
  }
}
