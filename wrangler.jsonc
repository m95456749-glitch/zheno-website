{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zheno",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  // Assets-only Worker: no server entrypoint, no Pages deployment command.
  // Domain routes are intentionally omitted until workers.dev is verified.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
