{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zheno",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  // Assets-only Worker: no server entrypoint, no Pages deployment command.
  // Domain routes are intentionally omitted until workers.dev is verified.
  // Official branch Previews: assets/compatibility stay top-level.
  // No runtime bindings are needed for this assets-only Worker.
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
